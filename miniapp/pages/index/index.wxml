<!--pages/index/index.wxml - 收银台-->
<view class="cashier-page">
  <!-- 顶部状态栏 -->
  <view class="top-bar">
    <view class="top-bar-left">
      <text class="top-title">收银台</text>
    </view>
    <view class="top-bar-right">
      <view class="conn-status {{serverConnected ? 'connected' : 'disconnected'}}">
        <view class="conn-dot"></view>
        <text>{{serverConnected ? '已连接' : '未连接'}}</text>
      </view>
    </view>
  </view>

  <!-- 搜索/扫码区域 -->
  <view class="search-section">
    <view class="search-bar">
      <view class="search-input-wrap">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="扫码或输入商品名称/条码"
          value="{{searchQuery}}"
          bindinput="onSearchInput"
          bindconfirm="doSearch"
          confirm-type="search"
          disabled="{{searching}}"
        />
        <view class="search-loading" wx:if="{{searching}}">
          <view class="loading-spinner"></view>
        </view>
      </view>
      <view class="scan-btn" bindtap="scanBarcode">
        <text class="scan-icon">📷</text>
      </view>
    </view>
    <!-- 添加成功提示 -->
    <view class="add-toast" wx:if="{{lastAddedItem}}">
      <text>✅ 已添加: {{lastAddedItem}}</text>
    </view>
  </view>

  <!-- 购物车区域 -->
  <view class="cart-section">
    <view class="cart-header">
      <text class="cart-title">购物车</text>
      <text class="cart-count" wx:if="{{totalItems > 0}}">{{totalItems}} 件</text>
      <text class="cart-clear" wx:if="{{cartItems.length > 0}}" bindtap="clearCart">清空</text>
    </view>

    <!-- 购物车列表 -->
    <scroll-view class="cart-list" scroll-y wx:if="{{cartItems.length > 0}}">
      <view class="cart-item" wx:for="{{cartItems}}" wx:key="id">
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-barcode">{{item.barcode}}</text>
        </view>
        <view class="item-controls">
          <view class="qty-control">
            <view class="qty-btn minus" data-index="{{index}}" bindtap="decreaseQty">
              <text>-</text>
            </view>
            <text class="qty-value">{{item.quantity}}</text>
            <view class="qty-btn plus" data-index="{{index}}" bindtap="increaseQty">
              <text>+</text>
            </view>
          </view>
          <view class="item-price-col">
            <text class="item-unit-price">¥{{item.price}}</text>
            <text class="item-subtotal">¥{{item.subtotal}}</text>
          </view>
        </view>
        <view class="item-delete" data-index="{{index}}" bindtap="removeItem">
          <text>✕</text>
        </view>
      </view>
    </scroll-view>

    <!-- 空购物车 -->
    <view class="cart-empty" wx:if="{{cartItems.length === 0}}">
      <text class="empty-icon">🛒</text>
      <text class="empty-text">购物车为空</text>
      <text class="empty-hint">扫描条码或搜索商品添加</text>
    </view>
  </view>

  <!-- 底部结算栏 -->
  <view class="checkout-bar">
    <view class="checkout-info">
      <text class="checkout-label">合计：</text>
      <text class="checkout-amount">¥{{totalAmount}}</text>
    </view>
    <view
      class="checkout-btn {{cartItems.length === 0 || checkingOut ? 'disabled' : ''}}"
      bindtap="checkout"
    >
      <text>{{checkingOut ? '结账中...' : '结账'}}</text>
    </view>
  </view>

  <!-- 未配置服务器提示 -->
  <view class="no-server-overlay" wx:if="{{!serverUrl}}">
    <view class="no-server-card">
      <text class="no-server-icon">⚙️</text>
      <text class="no-server-title">请先配置服务器</text>
      <text class="no-server-desc">前往设置页面配置服务器地址后即可使用收银功能</text>
      <navigator url="/pages/settings/settings" open-type="switchTab" class="btn-go-settings">
        前往设置
      </navigator>
    </view>
  </view>
</view>
