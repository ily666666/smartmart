/* pages/index/index.wxss - 收银台样式 */

.cashier-page {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ========== 顶部状态栏 ========== */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #eee;
}

.top-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.conn-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.conn-status.connected {
  background: #ecfdf5;
  color: #059669;
}

.conn-status.disconnected {
  background: #fef2f2;
  color: #dc2626;
}

.conn-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.connected .conn-dot {
  background: #10b981;
}

.disconnected .conn-dot {
  background: #ef4444;
}

/* ========== 搜索栏 ========== */
.search-section {
  padding: 20rpx 24rpx 0;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
}

.search-loading {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e0e0e0;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.scan-btn {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.3);
}

.scan-btn:active {
  transform: scale(0.95);
}

.scan-icon {
  font-size: 40rpx;
}

/* 添加成功提示 */
.add-toast {
  margin-top: 12rpx;
  padding: 12rpx 24rpx;
  background: #ecfdf5;
  border-radius: 10rpx;
  text-align: center;
}

.add-toast text {
  font-size: 26rpx;
  color: #059669;
}

/* ========== 购物车区域 ========== */
.cart-section {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.cart-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.cart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.cart-count {
  font-size: 24rpx;
  color: #4f46e5;
  background: #eef2ff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
}

.cart-clear {
  font-size: 26rpx;
  color: #999;
  margin-left: auto;
  padding: 8rpx 20rpx;
}

.cart-clear:active {
  color: #ef4444;
}

/* 购物车列表 */
.cart-list {
  flex: 1;
  max-height: calc(100vh - 520rpx - env(safe-area-inset-bottom));
}

.cart-item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.item-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-barcode {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.item-controls {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
}

/* 数量控制 */
.qty-control {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.qty-btn.minus {
  background: #f5f5f5;
  color: #666;
}

.qty-btn.minus:active {
  background: #e5e5e5;
}

.qty-btn.plus {
  background: #eef2ff;
  color: #4f46e5;
}

.qty-btn.plus:active {
  background: #ddd6fe;
}

.qty-value {
  width: 56rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 价格列 */
.item-price-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 100rpx;
}

.item-unit-price {
  font-size: 22rpx;
  color: #999;
}

.item-subtotal {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 删除按钮 */
.item-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.item-delete text {
  font-size: 24rpx;
  color: #ccc;
}

.item-delete:active text {
  color: #ef4444;
}

/* 空购物车 */
.cart-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #ccc;
}

/* ========== 底部结算栏 ========== */
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + 100rpx + env(safe-area-inset-bottom));
  background: white;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.checkout-info {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.checkout-label {
  font-size: 28rpx;
  color: #666;
}

.checkout-amount {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-left: 8rpx;
}

.checkout-btn {
  width: 240rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
}

.checkout-btn:active {
  transform: scale(0.98);
}

.checkout-btn text {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.checkout-btn.disabled {
  background: #d0d0d0;
  box-shadow: none;
}

.checkout-btn.disabled:active {
  transform: none;
}

/* ========== 未配置服务器蒙层 ========== */
.no-server-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.no-server-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  max-width: 600rpx;
}

.no-server-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.no-server-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.no-server-desc {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.btn-go-settings {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 400rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
  text-align: center;
  line-height: 90rpx;
}
